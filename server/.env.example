# MATRIX Backend Environment Variables
MATRIX_DATABASE_URL=sqlite:///./matrix.db
MATRIX_SPAN_STORE=memory
MATRIX_CLICKHOUSE_URL=http://localhost:8123
MATRIX_CLICKHOUSE_DATABASE=matrix
MATRIX_ADMIN_TOKEN=matrix-admin-dev-token
MATRIX_JWT_SECRET=matrix-insecure-dev-secret-change-in-prod
MATRIX_JWT_EXP_HOURS=72
