# Copy to deploy/.env and replace every "change-me". No real secrets belong in this file.
# Passwords go into URLs: use URL-safe characters (e.g. `openssl rand -hex 24`).

# Required
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
# Public origin of the web (scheme + host [+ port]); the Origin of every write must match it exactly.
# Production: https://matrix.example.com. Local use: http://localhost:3000 (plus MATRIX_INSECURE_COOKIES=1 on plain HTTP).
MATRIX_WEB_ORIGIN=https://matrix.example.com

# Optional
# 1 = cookies without Secure, ONLY for local plain HTTP (never in production)
MATRIX_INSECURE_COOKIES=
# /api/v1/admin/* token (empty = admin routes off; the matrix-admin CLI works without it)
MATRIX_ADMIN_TOKEN=
# Reverse proxy in front of the web: 1 = trust X-Forwarded-For/-Proto; header the API trusts for the client IP
MATRIX_WEB_TRUST_FORWARDED_FOR=0
MATRIX_TRUSTED_PROXY_HEADER=
# CIDRs dos proxies de confianca (separados por virgula). Vazio = o cabecalho acima nunca e aceito.
# Exemplo para a rede interna do compose: 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
MATRIX_TRUSTED_PROXIES=
# Server limits
MATRIX_PASSWORD_HASH_CONCURRENCY=4
MATRIX_MAX_RUNS_PER_PROJECT=100000
MATRIX_MAX_ACTIVE_RUNS_PER_PROJECT=1000
# Artifact store: local (validated, volume artifacts-data). s3 and MATRIX_S3_* are NOT validated in this stack.
MATRIX_ARTIFACT_BACKEND=local
# Evaluation judge & Gateway providers (empty provider = offline heuristic judge, test/demo only)
MATRIX_JUDGE_PROVIDER=
MATRIX_JUDGE_MODEL=
MATRIX_EMBEDDING_MODEL=
MATRIX_OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Registry webhooks Fernet encryption secret (`openssl rand -hex 32`) & Sandbox image allowlist
MATRIX_SECRET_KEY=
MATRIX_SANDBOX_IMAGES=python:3.12-slim
# Local model server (ADR-016; `make llm-up && make llm-pull`). Endpoints are trusted by the operator:
# only these hosts may be private/loopback, only for model/embedding calls. Empty = none.
MATRIX_LOCAL_MODEL_ENDPOINTS=http://ollama:11434
MATRIX_LOCAL_LLM_URL=http://ollama:11434
MATRIX_LOCAL_CHAT_MODEL=qwen2.5:0.5b
MATRIX_LOCAL_EMBED_MODEL=all-minilm
MATRIX_LOCAL_VISION_MODEL=moondream
OLLAMA_KEEP_ALIVE=5m
# Optional dev-only S3 service (`docker compose --profile dev up`)
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
