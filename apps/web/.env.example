# MATRIX Web Frontend Environment Variables

# URL of the backend API (without trailing slash or /api/v1 suffix)
MATRIX_API_URL=http://localhost:8000

# API key for direct server authentication (optional if logging in via /login)
MATRIX_API_KEY=mx_default_dev_key

# Set to 1 to run completely offline with mock data (no Python backend required)
# MATRIX_MOCK=1

# Automatically fallback to mock data if the backend is unreachable or returns 404/500
# MATRIX_FALLBACK_TO_MOCK=1
